{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "创建输出目录",
            "type": "shell",
            "command": "if (-not (Test-Path \"${workspaceFolder}/output\")) { New-Item -ItemType Directory -Path \"${workspaceFolder}/output\" | Out-Null }",
            "problemMatcher": []
        },
        {
            "label": "创建临时目录",
            "type": "shell",
            "command": "if (-not (Test-Path \"${workspaceFolder}/temp\")) { New-Item -ItemType Directory -Path \"${workspaceFolder}/temp\" | Out-Null }",
            "problemMatcher": []
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe 生成活动文件",
            "command": "C:/tool/mingw64/bin/g++.exe",
            "dependsOn": [
                "创建输出目录",
                "创建临时目录"
            ],
            "args": [
                "-g",
                "-std=c++17",
                "-static",
                "-DSFML_STATIC",
                "-finput-charset=UTF-8",
                "-fexec-charset=UTF-8",
                "-IC:/tool/SFML-2.6.2/include",
                "${workspaceFolder}/src/system.cpp",
                "${workspaceFolder}/src/number_parser.cpp",
                "${workspaceFolder}/src/analysis_rules.cpp",
                "${workspaceFolder}/src/sensor_display.cpp",
                "${workspaceFolder}/src/server_client.cpp",
                "${workspaceFolder}/src/data_source.cpp",
                "${workspaceFolder}/src/error_handler.cpp",
                "${workspaceFolder}/src/system_utils.cpp",
                "-o",
                "${workspaceFolder}/output/system.exe",
                "-LC:/tool/SFML-2.6.2/lib",
                "-lsfml-graphics-s",
                "-lsfml-window-s",
                "-lsfml-system-s",
                "-lopengl32",
                "-lgdi32",
                "-lwinmm",
                "-lws2_32",
                "-lwinhttp",
                "-lfreetype",
                "-Wall"
            ],
            "options": {
                "cwd": "C:/tool/mingw64/bin"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "编译 system.exe（静态链接，无 DLL 依赖）"
        }
    ]
}
